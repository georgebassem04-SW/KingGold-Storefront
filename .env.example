# Which client config to load (see config/clients/)
NEXT_PUBLIC_CLIENT_ID=demo

# Data source: "mock" uses local JSON in /mock-data, "api" calls the dashboard API
NEXT_PUBLIC_DATA_SOURCE=mock

# Dashboard API base URL (used when NEXT_PUBLIC_DATA_SOURCE=api)
NEXT_PUBLIC_API_BASE_URL=https://dashboard.example.com/api

# Shared secret the dashboard sends to POST /api/revalidate for instant updates
REVALIDATE_SECRET=change-me

# ===== EMAIL (order confirmation) =====
# console = save emails as HTML files in .email-previews/ (development)
# smtp    = any mail server   |   resend = resend.com
EMAIL_PROVIDER=console
EMAIL_FROM="My Store <orders@mystore.com>"
# Where staff get a copy of every new order (leave empty to disable)
ORDERS_NOTIFY_EMAIL=
# Public address of the website, used for links inside emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SMTP (when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Resend (when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
# Secret for POST /api/email/order-confirmation (dashboard "resend email" button)
EMAIL_API_SECRET=change-me
# Set to false if the dashboard sends order emails itself (to avoid double emails)
SEND_ORDER_EMAILS=true

# ===== CUSTOMER ACCOUNTS =====
# Long random text used to sign the login cookie (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Sign in with Google (Google Cloud Console -> Credentials -> OAuth client ID -> Web application)
# Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Link to the dashboard while developing (sample-data mode only) -----
# When set, the website reads from the dashboard running on your computer (port 3002):
#   - the look published in Theme & design (colours, fonts, logo, texts)
#   - products and categories (only the visible ones) — changes show on the next page load
# Leave empty (or stop the dashboard) to use config/clients/<client>.ts and mock-data/*.json only.
DASHBOARD_URL=http://localhost:3002
